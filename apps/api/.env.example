# Copy to .env and adjust. Secrets must never be committed.
PORT=3000

# SQLite file path. Use :memory: for an ephemeral database.
DATABASE_PATH=./data/orbita.db

# Access token signing secret (HS256) and lifetime in seconds.
JWT_SECRET=change-me-jwt-secret
JWT_TTL_SECONDS=1800

# Shared secret used by the payment gateway to sign webhook bodies (HMAC-SHA256).
WEBHOOK_SECRET=change-me-webhook-secret

# How long a stored Idempotency-Key response is replayed before the key can be reused.
IDEMPOTENCY_TTL_HOURS=24

# Mark the session cookie as Secure (HTTPS only). Keep false for http://localhost.
COOKIE_SECURE=false

# Allowed browser origin for CORS. Cookie-authenticated writes must come from this origin.
CORS_ORIGIN=http://localhost:5173
